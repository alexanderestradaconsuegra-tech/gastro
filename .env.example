# ─────────────────────────────────────────────────────────────
# GASTRO POS - Variables de entorno
# Copiar a .env.local (para Next.js) o .env (para Docker)
# NUNCA commitear valores reales
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# URL del proyecto (visible en Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon/pública (safe para el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave service_role (SOLO servidor / n8n - nunca al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── n8n ───────────────────────────────────────────────────────
# URL base de los webhooks de n8n (sin trailing slash)
N8N_WEBHOOK_BASE_URL=https://n8n.tu-dominio.com

# ── Notificaciones opcionales ─────────────────────────────────

# Telegram (para alertas críticas en cocina)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Business API (para confirmaciones al cliente)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
