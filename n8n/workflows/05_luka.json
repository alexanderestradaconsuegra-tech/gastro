      "id": "set-context",
      "name": "Extraer Contexto",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "systemMessage": "Eres Luka, el asistente del restaurante NIDO. Eres elegante, amable y muy conciso. Respondes siempre en español.\n\nContexto del mensaje:\n- El mensaje incluye un prefijo [Mesa:X | Sesión:Y | Rol:Z] con el contexto de quien escribe.\n- Si el Rol es 'admin', 'camarero', 'cocina' o 'caja' eres un asistente de staff: puedes dar resúmenes, recomendar acciones, responder sobre el sistema.\n- Si el Rol es 'cliente' eres el asistente de mesa: ayudas con el menú, llamas al camarero, solicitas la cuenta.\n\nReglas:\n- Máximo 2-3 oraciones por respuesta.\n- Si el cliente quiere llamar al camarero, usa la herramienta 'Llamar Camarero'.\n- Si el cliente quiere pagar / pedir la cuenta, usa la herramienta 'Solicitar Cuenta'.\n- Si preguntan por el menú o platos, usa la herramienta 'Obtener Menú' primero.\n- Antes de ejecutar una acción confirma con el usuario una sola vez.\n- Nunca inventes información sobre platos o precios; consulta siempre la herramienta.",
        "options": {}
      },
      "id": "ai-agent-luka",
      "name": "Luka AI",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "openai-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [520, 520],
      "credentials": {
        "openAiApi": {
          "id": "SztW5Pu9qLL0P9TN",
          "name": "OpenAi account 3"
        }
      }
    },
    {
      "parameters": {},
      "id": "memory",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [680, 520]
    },
    {
      "parameters": {
        "name": "obtener_menu",
        "description": "Obtiene el menú completo del restaurante con nombre, descripción, precio, alérgenos, tiempo de preparación y disponibilidad. Úsala cuando el cliente pregunte por platos, precios, alérgenos o recomendaciones.",
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/menu_items?select=name,category,price,description,avg_prep_minutes,allergens,tags,available,wine_pair&available=eq.true&order=category",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "tool-menu",
      "name": "Obtener Menú",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 520]
    },
    {
      "parameters": {
        "name": "llamar_camarero",
        "description": "Llama al camarero a la mesa. Requiere un parámetro 'reason' con el motivo (string). Úsala cuando el cliente quiera llamar al camarero o pida ayuda presencial.",
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE_URL }}/webhook/camarero-call",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"restaurant_id\": \"{{ $('Extraer Contexto').first().json.restaurant_id }}\",\n  \"qr_token\": \"{{ $('Extraer Contexto').first().json.qr_token }}\",\n  \"table_id\": {{ $('Extraer Contexto').first().json.table_id }},\n  \"session_id\": \"{{ $('Extraer Contexto').first().json.session_id }}\",\n  \"reason\": \"{{ $fromAI('reason', 'Motivo por el que el cliente llama al camarero', 'string') }}\",\n  \"source\": \"luka_ai\"\n}",
        "options": {}
      },
      "id": "tool-waiter",
      "name": "Llamar Camarero",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 520]
    },
    {
