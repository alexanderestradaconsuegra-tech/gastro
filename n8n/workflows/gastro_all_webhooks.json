    {
      "parameters": {
        "jsCode": "// ── Validate rating and sanitize comment ─────────────────────\nconst body = $input.first().json.body ?? $input.first().json;\n\n// Required fields\nif (!body.restaurant_id) {\n  throw new Error('Missing required field: restaurant_id');\n}\n\n// Validate rating (integer 1–5)\nconst rating = parseInt(body.rating, 10);\nif (isNaN(rating) || rating < 1 || rating > 5) {\n  throw new Error('rating must be an integer between 1 and 5');\n}\n\n// Sanitize comment: strip HTML tags, trim, limit to 1000 chars\nlet comment = null;\nif (body.comment && typeof body.comment === 'string') {\n  comment = body.comment\n    .replace(/<[^>]*>/g, '')   // strip HTML\n    .replace(/[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]/g, '')  // strip control chars\n    .trim()\n    .slice(0, 1000);            // hard limit\n  if (comment.length === 0) comment = null;\n}\n\n// Validate source\nconst allowedSources = ['table_qr', 'admin', 'whatsapp', 'email'];\nconst source = allowedSources.includes(body.source) ? body.source : 'table_qr';\n\nreturn [{\n  json: {\n    restaurant_id: body.restaurant_id,\n    session_id: body.session_id ?? null,\n    table_id: body.table_id ?? null,\n    waiter_id: body.waiter_id ?? null,\n    rating,\n    comment,\n    source\n  }\n}];"
      },
