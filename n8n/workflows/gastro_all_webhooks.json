      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nif (!body.restaurant_id) throw new Error('Missing restaurant_id');\nconst rating = parseInt(body.rating, 10);\nif (isNaN(rating) || rating < 1 || rating > 5) throw new Error('rating must be 1-5');\nlet comment = null;\nif (body.comment && typeof body.comment === 'string') {\n  comment = body.comment.replace(/<[^>]*>/g, '').trim().slice(0, 1000);\n  if (comment.length === 0) comment = null;\n}\nconst allowedSources = ['table_qr','admin','whatsapp','email'];\nconst source = allowedSources.includes(body.source) ? body.source : 'table_qr';\nreturn [{ json: { restaurant_id: body.restaurant_id, session_id: body.session_id ?? null, table_id: body.table_id ?? null, waiter_id: body.waiter_id ?? null, rating, comment, source } }];"
