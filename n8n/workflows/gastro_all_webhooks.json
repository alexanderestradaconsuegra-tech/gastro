    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nconst restaurant_id = raw.restaurant_id || raw.restaurantId || 'nido';\nconst table_id      = raw.table_id      ?? raw.tableId      ?? null;\nconst session_id    = raw.session_id    || raw.sessionId    || null;\nconst rating = parseInt(raw.rating, 10);\nif (isNaN(rating) || rating < 1 || rating > 5) throw new Error('rating must be 1-5');\nlet comment = null;\nif (raw.comment && typeof raw.comment === 'string') {\n  comment = raw.comment.replace(/<[^>]*>/g,'').trim().slice(0,1000) || null;\n}\nconst source = ['table_qr','admin','whatsapp','email'].includes(raw.source) ? raw.source : 'table_qr';\nreturn [{ json: { restaurant_id, session_id, table_id, rating, comment, source } }];"
