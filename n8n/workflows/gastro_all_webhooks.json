{
  "name": "Gastro - Todos los Webhooks",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "order-create", "responseMode": "responseNode", "options": {} },
      "id": "wh-order", "name": "Webhook - Order Create",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-400, 200], "webhookId": "order-create"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nconst restaurant_id = raw.restaurant_id || raw.restaurantId || 'nido';\nconst qr_token = raw.qr_token || raw.qrToken || '';\nconst table_id = raw.table_id ?? raw.tableId ?? null;\nconst session_id = raw.session_id || raw.sessionId || null;\nconst notes = raw.notes || raw.note || null;\nconst rawItems = raw.items || [];\nif (!rawItems.length) throw new Error('items vacíos');\nconst items = rawItems.map(i => ({ menu_item_id: i.menu_item_id || i.id || '', dish_name: i.dish_name || i.name || '', unit_price: i.unit_price || i.price || 0, qty: (typeof i.qty === 'number' && i.qty > 0) ? i.qty : 1 }));\nconst digits = String(Math.floor(Math.random() * 10000)).padStart(4, '0');\nconst orderId = 'ORD-' + digits;\nconst total = raw.total || items.reduce((s, i) => s + i.unit_price * i.qty, 0);\nreturn [{ json: { orderId, restaurant_id, qr_token, table_id, session_id, notes, channel: raw.channel || 'QR Mesa', priority: raw.priority || 'Normal', eta_minutes: raw.eta_minutes || 18, total, items } }];"
      },
      "id": "validate-order", "name": "Validate Order",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-200, 200]
    },
    {
      "parameters": {
        "operation": "create", "tableId": "orders",
        "dataToSend": "defineBelow",
        "fieldsUi": { "fieldValues": [
          { "fieldId": "id",            "fieldValue": "={{ $json.orderId }}" },
          { "fieldId": "restaurant_id", "fieldValue": "={{ $json.restaurant_id }}" },
          { "fieldId": "session_id",    "fieldValue": "={{ $json.session_id }}" },
          { "fieldId": "table_id",      "fieldValue": "={{ $json.table_id }}" },
          { "fieldId": "status",        "fieldValue": "received" },
          { "fieldId": "priority",      "fieldValue": "={{ $json.priority }}" },
          { "fieldId": "channel",       "fieldValue": "={{ $json.channel }}" },
          { "fieldId": "eta_minutes",   "fieldValue": "={{ $json.eta_minutes }}" },
          { "fieldId": "notes",         "fieldValue": "={{ $json.notes }}" },
          { "fieldId": "total",         "fieldValue": "={{ $json.total }}" }
        ]}
      },
      "id": "insert-order", "name": "Insert Order",
      "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [0, 200],
      "credentials": { "supabaseApi": { "id": "0IY3nFZdR6FVHOZs", "name": "Supabase account" } }
    },
    {
      "parameters": {
        "jsCode": "const data = $('Validate Order').item.json;\nreturn data.items.map(i => ({ json: { order_id: data.orderId, menu_item_id: i.menu_item_id, dish_name: i.dish_name, qty: i.qty, unit_price: i.unit_price, status: 'pending' } }));"
      },
      "id": "split-items", "name": "Split Order Items",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [200, 200]
    },
    {
      "parameters": {
        "operation": "create", "tableId": "order_items",
        "dataToSend": "autoMapInputData"
      },
      "id": "insert-items", "name": "Insert Order Items",
      "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [400, 200],
      "credentials": { "supabaseApi": { "id": "0IY3nFZdR6FVHOZs", "name": "Supabase account" } }
    },
    {
      "parameters": {
        "operation": "update", "tableId": "tables",
        "filterType": "string",
        "matchType": "allFilters",
        "filters": { "conditions": [{ "keyName": "qr_token", "condition": "eq", "keyValue": "={{ $('Validate Order').item.json.qr_token }}" }] },
        "dataToSend": "defineBelow",
        "fieldsUi": { "fieldValues": [{ "fieldId": "status", "fieldValue": "Pedido nuevo" }] }
      },
      "id": "update-table-order", "name": "Update Table - Pedido nuevo",
      "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [600, 200],
      "credentials": { "supabaseApi": { "id": "0IY3nFZdR6FVHOZs", "name": "Supabase account" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={\"ok\":true,\"orderId\":\"{{$('Validate Order').item.json.orderId}}\"}", "options": { "responseCode": 201 } },
      "id": "respond-order", "name": "Respond - Order OK",
      "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [800, 200]
    },

    {
      "parameters": { "httpMethod": "POST", "path": "camarero-call", "responseMode": "responseNode", "options": {} },
      "id": "wh-camarero", "name": "Webhook - Camarero Call",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-400, 440], "webhookId": "camarero-call"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nconst callId = 'C-' + Math.random().toString(36).slice(2,10).toUpperCase();\nconst callType = raw.call_type || raw.reason || 'Camarero';\nlet priority = 'Normal';\nif (callType.toLowerCase().includes('alergi')) priority = 'Crítica';\nelse if (callType.toLowerCase().includes('urgente') || callType.toLowerCase().includes('cuenta')) priority = 'Alta';\nlet tableStatus = 'Camarero ocupado';\nif (callType.toLowerCase().includes('cuenta') || callType.toLowerCase().includes('cobro')) tableStatus = 'Solicita cobro';\nreturn [{ json: { callId, restaurant_id: raw.restaurant_id || raw.restaurantId || 'nido', qr_token: raw.qr_token || raw.qrToken || '', table_id: raw.table_id ?? raw.tableId ?? null, session_id: null, call_type: callType, priority, message: callType, tableStatus } }];"
      },
      "id": "validate-camarero", "name": "Validate Camarero",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-200, 440]
    },
    {
      "parameters": {
        "operation": "create", "tableId": "calls",
        "dataToSend": "defineBelow",
        "fieldsUi": { "fieldValues": [
          { "fieldId": "id",            "fieldValue": "={{ $json.callId }}" },
          { "fieldId": "restaurant_id", "fieldValue": "={{ $json.restaurant_id }}" },
          { "fieldId": "table_id",      "fieldValue": "={{ $json.table_id }}" },
          { "fieldId": "source",        "fieldValue": "mesa" },
          { "fieldId": "call_type",     "fieldValue": "={{ $json.call_type }}" },
          { "fieldId": "priority",      "fieldValue": "={{ $json.priority }}" },
          { "fieldId": "status",        "fieldValue": "Pendiente" },
          { "fieldId": "message",       "fieldValue": "={{ $json.message }}" }
        ]}
      },
      "id": "insert-call", "name": "Insert Call",
      "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [0, 440],
      "credentials": { "supabaseApi": { "id": "0IY3nFZdR6FVHOZs", "name": "Supabase account" } }
    },
    {
      "parameters": {
        "operation": "update", "tableId": "tables",
        "filterType": "string",
        "matchType": "allFilters",
        "filters": { "conditions": [{ "keyName": "qr_token", "condition": "eq", "keyValue": "={{ $('Validate Camarero').item.json.qr_token }}" }] },
        "dataToSend": "defineBelow",
        "fieldsUi": { "fieldValues": [{ "fieldId": "status", "fieldValue": "={{ $('Validate Camarero').item.json.tableStatus }}" }] }
      },
      "id": "update-table-camarero", "name": "Update Table - Camarero",
      "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [200, 440],
      "credentials": { "supabaseApi": { "id": "0IY3nFZdR6FVHOZs", "name": "Supabase account" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={\"ok\":true,\"callId\":\"{{$('Validate Camarero').item.json.callId}}\"}", "options": { "responseCode": 201 } },
      "id": "respond-camarero", "name": "Respond - Camarero OK",
      "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [400, 440]
    },

    {
      "parameters": { "httpMethod": "POST", "path": "bill-request", "responseMode": "responseNode", "options": {} },
      "id": "wh-bill", "name": "Webhook - Bill Request",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-400, 660], "webhookId": "bill-request"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nconst callId = 'C-' + Math.random().toString(36).slice(2,10).toUpperCase();\nreturn [{ json: { callId, restaurant_id: raw.restaurant_id || raw.restaurantId || 'nido', qr_token: raw.qr_token || raw.qrToken || '', table_id: raw.table_id ?? raw.tableId ?? null } }];"
      },
      "id": "validate-bill", "name": "Validate Bill",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-200, 660]
    },
    {
      "parameters": {
        "operation": "create", "tableId": "calls",
        "dataToSend": "defineBelow",
        "fieldsUi": { "fieldValues": [
          { "fieldId": "id",            "fieldValue": "={{ $json.callId }}" },
          { "fieldId": "restaurant_id", "fieldValue": "={{ $json.restaurant_id }}" },
          { "fieldId": "table_id",      "fieldValue": "={{ $json.table_id }}" },
          { "fieldId": "source",        "fieldValue": "mesa" },
          { "fieldId": "call_type",     "fieldValue": "Solicita cobro" },
          { "fieldId": "priority",      "fieldValue": "Alta" },
          { "fieldId": "status",        "fieldValue": "Pendiente" },
          { "fieldId": "message",       "fieldValue": "Solicita la cuenta" }
        ]}
      },
      "id": "insert-bill-call", "name": "Insert Bill Call",
      "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [0, 660],
      "credentials": { "supabaseApi": { "id": "0IY3nFZdR6FVHOZs", "name": "Supabase account" } }
    },
    {
      "parameters": {
        "operation": "update", "tableId": "tables",
        "filterType": "string",
        "matchType": "allFilters",
        "filters": { "conditions": [{ "keyName": "qr_token", "condition": "eq", "keyValue": "={{ $('Validate Bill').item.json.qr_token }}" }] },
        "dataToSend": "defineBelow",
        "fieldsUi": { "fieldValues": [{ "fieldId": "status", "fieldValue": "Solicita cobro" }] }
      },
      "id": "update-table-bill", "name": "Update Table - Solicita Cobro",
      "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [200, 660],
      "credentials": { "supabaseApi": { "id": "0IY3nFZdR6FVHOZs", "name": "Supabase account" } }
