    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nconst rating = parseInt(raw.rating, 10);\nif (isNaN(rating) || rating < 1 || rating > 5) throw new Error('rating must be 1-5');\nlet comment = null;\nif (raw.comment && typeof raw.comment === 'string') { comment = raw.comment.replace(/<[^>]*>/g,'').trim().slice(0,1000) || null; }\nreturn [{ json: { restaurant_id: raw.restaurant_id || raw.restaurantId || 'nido', table_id: raw.table_id ?? raw.tableId ?? null, rating, comment, source: raw.source || 'table_qr' } }];"
      },
