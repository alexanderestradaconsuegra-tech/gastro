    {
      "parameters": {
        "jsCode": "// Acepta tanto snake_case como camelCase\nconst raw = $input.first().json.body ?? $input.first().json;\n\nconst restaurant_id = raw.restaurant_id || raw.restaurantId || 'nido';\nconst qr_token     = raw.qr_token     || raw.qrToken     || '';\nconst table_id     = raw.table_id     ?? raw.tableId     ?? null;\nconst session_id   = raw.session_id   || raw.sessionId   || null;\nconst notes        = raw.notes        || raw.note        || null;\nconst channel      = raw.channel      || 'QR Mesa';\nconst priority     = raw.priority     || 'Normal';\nconst eta_minutes  = raw.eta_minutes  || raw.eta         || 18;\n\nconst rawItems = raw.items || [];\nif (!Array.isArray(rawItems) || rawItems.length === 0) {\n  throw new Error('items must be a non-empty array');\n}\n\n// Normaliza items: acepta {menu_item_id,dish_name,unit_price} o {id,name,price}\nconst items = rawItems.map(i => ({\n  menu_item_id: i.menu_item_id || i.id || '',\n  dish_name:    i.dish_name    || i.name || '',\n  unit_price:   i.unit_price   || i.price || 0,\n  qty:          (typeof i.qty === 'number' && i.qty > 0) ? i.qty : 1\n}));\n\nconst digits   = String(Math.floor(Math.random() * 10000)).padStart(4, '0');\nconst orderId  = 'ORD-' + digits;\nconst finalSessionId = session_id || 'SES-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7);\nconst total = raw.total || items.reduce((s, i) => s + i.unit_price * i.qty, 0);\n\nreturn [{ json: { orderId, sessionId: finalSessionId, restaurant_id, qr_token, table_id, session_id, notes, channel, priority, eta_minutes, total, items } }];"
      },
