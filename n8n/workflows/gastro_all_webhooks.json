      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst required = ['restaurant_id', 'qr_token', 'items'];\nfor (const field of required) {\n  if (!body[field]) throw new Error(`Missing required field: ${field}`);\n}\nif (!Array.isArray(body.items) || body.items.length === 0) {\n  throw new Error('items must be a non-empty array');\n}\nfor (const item of body.items) {\n  if (!item.menu_item_id || !item.dish_name || !item.unit_price) {\n    throw new Error('Each item requires menu_item_id, dish_name and unit_price');\n  }\n  if (typeof item.qty !== 'number' || item.qty < 1) item.qty = 1;\n}\nconst digits = String(Math.floor(Math.random() * 10000)).padStart(4, '0');\nconst orderId = 'ORD-' + digits;\nconst sessionId = body.session_id || 'SES-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7);\nconst total = body.items.reduce((sum, item) => sum + (item.unit_price * (item.qty ?? 1)), 0);\nconst eta = body.eta_minutes ?? 18;\nreturn [{ json: { orderId, sessionId, restaurant_id: body.restaurant_id, qr_token: body.qr_token, table_id: body.table_id ?? null, waiter_id: body.waiter_id ?? null, notes: body.notes ?? null, channel: body.channel ?? 'QR Mesa', priority: body.priority ?? 'Normal', eta_minutes: eta, total, items: body.items } }];"
      },
