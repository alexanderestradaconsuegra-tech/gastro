    },

    {
      "parameters": { "httpMethod": "POST", "path": "feedback", "responseMode": "responseNode", "options": {} },
      "id": "wh-feedback", "name": "Webhook - Feedback",
      "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-400, 880], "webhookId": "feedback"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body ?? $input.first().json;\nconst rating = parseInt(raw.rating, 10);\nif (isNaN(rating) || rating < 1 || rating > 5) throw new Error('rating must be 1-5');\nlet comment = null;\nif (raw.comment && typeof raw.comment === 'string') { comment = raw.comment.replace(/<[^>]*>/g,'').trim().slice(0,1000) || null; }\nreturn [{ json: { restaurant_id: raw.restaurant_id || raw.restaurantId || 'nido', table_id: raw.table_id ?? raw.tableId ?? null, rating, comment, source: raw.source || 'table_qr' } }];"
      },
      "id": "validate-feedback", "name": "Validate Feedback",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-200, 880]
    },
    {
      "parameters": {
        "operation": "create", "tableId": "reviews",
        "dataToSend": "defineBelow",
        "fieldsUi": { "fieldValues": [
          { "fieldId": "restaurant_id", "fieldValue": "={{ $json.restaurant_id }}" },
          { "fieldId": "table_id",      "fieldValue": "={{ $json.table_id }}" },
          { "fieldId": "rating",        "fieldValue": "={{ $json.rating }}" },
          { "fieldId": "comment",       "fieldValue": "={{ $json.comment }}" },
          { "fieldId": "source",        "fieldValue": "={{ $json.source }}" }
        ]}
      },
      "id": "insert-review", "name": "Insert Review",
      "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [0, 880],
      "credentials": { "supabaseApi": { "id": "0IY3nFZdR6FVHOZs", "name": "Supabase account" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "{\"ok\":true}", "options": { "responseCode": 201 } },
      "id": "respond-feedback", "name": "Respond - Feedback OK",
      "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [200, 880]
    }
  ],
  "pinData": {},
