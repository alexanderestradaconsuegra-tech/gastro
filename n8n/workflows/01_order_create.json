        "specifyBody": "json",
        "jsonBody": "={\n  \"id\": \"{{ $('Validate & Transform').item.json.orderId }}\",\n  \"restaurant_id\": \"{{ $('Validate & Transform').item.json.restaurant_id }}\",\n  \"session_id\": \"{{ $('Validate & Transform').item.json.sessionId }}\",\n  \"table_id\": {{ $('Validate & Transform').item.json.table_id !== null ? $('Validate & Transform').item.json.table_id : 'null' }},\n  \"waiter_id\": {{ $('Validate & Transform').item.json.waiter_id ? '\"' + $('Validate & Transform').item.json.waiter_id + '\"' : 'null' }},\n  \"status\": \"received\",\n  \"priority\": \"{{ $('Validate & Transform').item.json.priority }}\",\n  \"channel\": \"{{ $('Validate & Transform').item.json.channel }}\",\n  \"eta_minutes\": {{ $('Validate & Transform').item.json.eta_minutes }},\n  \"notes\": {{ $('Validate & Transform').item.json.notes ? '\"' + $('Validate & Transform').item.json.notes + '\"' : 'null' }},\n  \"total\": {{ $('Validate & Transform').item.json.total }}\n}",
        "options": {}
      },
      "id": "http-insert-order",
