{
  "name": "Gastro - Order Create",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-create",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-order-create",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "order-create"
    },
    {
      "parameters": {
        "jsCode": "// ── Validate & Transform ─────────────────────────────────────\nconst body = $input.first().json.body ?? $input.first().json;\n\n// Required fields\nconst required = ['restaurant_id', 'qr_token', 'items'];\nfor (const field of required) {\n  if (!body[field]) {\n    throw new Error(`Missing required field: ${field}`);\n  }\n}\n\nif (!Array.isArray(body.items) || body.items.length === 0) {\n  throw new Error('items must be a non-empty array');\n}\n\n// Validate each item\nfor (const item of body.items) {\n  if (!item.menu_item_id || !item.dish_name || !item.unit_price) {\n    throw new Error('Each item requires menu_item_id, dish_name and unit_price');\n  }\n  if (typeof item.qty !== 'number' || item.qty < 1) {\n    item.qty = 1;\n  }\n}\n\n// Generate Order ID: ORD-XXXX (4 random digits)\nconst digits = String(Math.floor(Math.random() * 10000)).padStart(4, '0');\nconst orderId = `ORD-${digits}`;\n\n// Generate Session ID if not provided\nconst sessionId = body.session_id || `SES-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;\n\n// Calculate total\nconst total = body.items.reduce((sum, item) => sum + (item.unit_price * (item.qty ?? 1)), 0);\n\n// Determine ETA (max prep time among items + 3 min buffer)\nconst eta = (body.eta_minutes ?? 18);\n\nreturn [{\n  json: {\n    orderId,\n    sessionId,\n    restaurant_id: body.restaurant_id,\n    qr_token: body.qr_token,\n    table_id: body.table_id ?? null,\n    waiter_id: body.waiter_id ?? null,\n    notes: body.notes ?? null,\n    channel: body.channel ?? 'QR Mesa',\n    priority: body.priority ?? 'Normal',\n    eta_minutes: eta,\n    total,\n    items: body.items\n  }\n}];"
      },
      "id": "code-validate-transform",
      "name": "Validate & Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
