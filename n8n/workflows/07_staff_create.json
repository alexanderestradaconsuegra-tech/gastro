    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": false, \"error\": \"{{ $json.message ?? $json.error ?? 'Error creando staff' }}\" }",
        "options": { "responseCode": 400 }
      },
      "id": "respond-error",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 500]
    }
  ],
