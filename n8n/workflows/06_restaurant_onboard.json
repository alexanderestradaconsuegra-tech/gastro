{
  "name": "Gastro - Restaurant Onboard",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "restaurant-onboard",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-onboard",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "restaurant-onboard"
    },
    {
      "parameters": {
        "jsCode": "// ── Validate & Prepare ───────────────────────────────────────\nconst body = $input.first().json.body ?? $input.first().json;\n\nconst required = ['restaurantName', 'ownerName', 'ownerEmail', 'ownerPassword'];\nfor (const field of required) {\n  if (!body[field] || String(body[field]).trim() === '') {\n    throw new Error(`Missing required field: ${field}`);\n  }\n}\n\n// Validate email format\nif (!/^[^@]+@[^@]+\\.[^@]+$/.test(body.ownerEmail)) {\n  throw new Error('Invalid email address');\n}\n\n// Generate restaurant ID: slug from name (lowercase, alphanumeric + hyphens)\nconst baseSlug = body.restaurantName\n  .toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '') // strip accents\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '')\n  .slice(0, 40);\n\n// Add short random suffix to avoid collisions\nconst suffix = Math.random().toString(36).slice(2, 6);\nconst restaurantId = `${baseSlug}-${suffix}`;\n\nreturn [{\n  json: {\n    restaurantId,\n    restaurantName: body.restaurantName.trim(),\n    legalName:      body.legalName?.trim()    || body.restaurantName.trim(),\n    rut:            body.rut?.trim()          || null,\n    address:        body.address?.trim()      || null,\n    phone:          body.phone?.trim()        || null,\n    website:        body.website?.trim()      || null,\n    ownerName:      body.ownerName.trim(),\n    ownerEmail:     body.ownerEmail.trim().toLowerCase(),\n    ownerPassword:  body.ownerPassword,\n    plan:           body.plan || 'starter'\n  }\n}];"
      },
      "id": "code-validate",
      "name": "Validate & Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/restaurants",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",         "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization",  "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",   "value": "application/json" },
            { "name": "Prefer",         "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"id\":         \"{{ $json.restaurantId }}\",\n  \"name\":       \"{{ $json.restaurantName }}\",\n  \"legal_name\": \"{{ $json.legalName }}\",\n  \"rut\":        {{ $json.rut ? '\"' + $json.rut + '\"' : 'null' }},\n  \"address\":    {{ $json.address ? '\"' + $json.address + '\"' : 'null' }},\n  \"phone\":      {{ $json.phone ? '\"' + $json.phone + '\"' : 'null' }},\n  \"website\":    {{ $json.website ? '\"' + $json.website + '\"' : 'null' }},\n  \"settings\":   {}\n}",
        "options": {}
      },
