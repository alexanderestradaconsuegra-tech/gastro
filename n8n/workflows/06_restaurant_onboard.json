        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"to\":              \"{{ $('Validate & Prepare').item.json.ownerEmail }}\",\n  \"restaurant_name\": \"{{ $('Validate & Prepare').item.json.restaurantName }}\",\n  \"owner_name\":      \"{{ $('Validate & Prepare').item.json.ownerName }}\",\n  \"restaurant_id\":   \"{{ $('Validate & Prepare').item.json.restaurantId }}\",\n  \"login_url\":       \"{{ $env.ADMIN_URL }}/login\"\n}",
        "continueOnFail": true,
        "options": {}
      },
