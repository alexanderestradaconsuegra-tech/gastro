    {
      "parameters": {
        "jsCode": "// Seed 5 default tables for the new restaurant\nconst rid = $('Validate & Prepare').item.json.restaurantId;\n\nconst tables = [\n  { table_number: 1, label: 'Mesa 1', zone: 'Salón',   qr_token: `${rid}-T1` },\n  { table_number: 2, label: 'Mesa 2', zone: 'Salón',   qr_token: `${rid}-T2` },\n  { table_number: 3, label: 'Mesa 3', zone: 'Salón',   qr_token: `${rid}-T3` },\n  { table_number: 4, label: 'Mesa 4', zone: 'Terraza', qr_token: `${rid}-T4` },\n  { table_number: 5, label: 'Mesa 5', zone: 'Terraza', qr_token: `${rid}-T5` },\n];\n\nreturn tables.map(t => ({\n  json: { restaurant_id: rid, ...t }\n}));"
      },
      "id": "build-tables",
      "name": "Build Default Tables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
