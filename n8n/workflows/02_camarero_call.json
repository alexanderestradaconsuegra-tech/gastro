{
  "name": "Gastro - Camarero Call",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "camarero-call",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-camarero-call",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "camarero-call"
    },
    {
      "parameters": {
        "jsCode": "// ── Validate & determine priority ────────────────────────────\nconst body = $input.first().json.body ?? $input.first().json;\n\n// Required fields\nconst required = ['restaurant_id', 'qr_token', 'call_type'];\nfor (const field of required) {\n  if (!body[field]) {\n    throw new Error(`Missing required field: ${field}`);\n  }\n}\n\n// Allowed call types\nconst allowedTypes = [\n  'Camarero', 'Agua', 'Cuenta', 'Alergia',\n  'Pregunta', 'Más pan', 'Servilletas', 'Otro'\n];\n\nif (!allowedTypes.includes(body.call_type)) {\n  // Accept unknown types but normalize\n  body.call_type = body.call_type.slice(0, 50);\n}\n\n// Auto-determine priority based on call type\nlet priority = body.priority ?? 'Normal';\nif (body.call_type === 'Alergia') {\n  priority = 'Crítica';\n} else if (body.call_type === 'Cuenta' || body.call_type === 'Camarero') {\n  priority = 'Alta';\n}\n\n// Generate call ID\nconst callId = 'C-' + Math.random().toString(36).slice(2, 10).toUpperCase();\n\n// Determine table status based on call type\nlet tableStatus = 'Camarero ocupado';\nif (body.call_type === 'Cuenta') {\n  tableStatus = 'Solicita cobro';\n}\n\nreturn [{\n  json: {\n    callId,\n    restaurant_id: body.restaurant_id,\n    qr_token: body.qr_token,\n    table_id: body.table_id ?? null,\n    session_id: body.session_id ?? null,\n    waiter_id: body.waiter_id ?? null,\n    call_type: body.call_type,\n    priority,\n    message: body.message ?? null,\n    source: 'mesa',\n    tableStatus\n  }\n}];"
      },
      "id": "code-validate",
      "name": "Validate & Set Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/calls",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"id\": \"{{ $json.callId }}\",\n  \"restaurant_id\": \"{{ $json.restaurant_id }}\",\n  \"table_id\": {{ $json.table_id !== null ? $json.table_id : 'null' }},\n  \"session_id\": {{ $json.session_id ? '\"' + $json.session_id + '\"' : 'null' }},\n  \"waiter_id\": {{ $json.waiter_id ? '\"' + $json.waiter_id + '\"' : 'null' }},\n  \"source\": \"mesa\",\n  \"call_type\": \"{{ $json.call_type }}\",\n  \"priority\": \"{{ $json.priority }}\",\n  \"status\": \"Pendiente\",\n  \"message\": {{ $json.message ? '\"' + $json.message + '\"' : 'null' }}\n}",
        "options": {}
      },
      "id": "http-insert-call",
      "name": "Insert Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/tables?qr_token=eq.{{ $('Validate & Set Priority').item.json.qr_token }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"{{ $('Validate & Set Priority').item.json.tableStatus }}\",\n  \"last_activity_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "http-update-table",
      "name": "Update Table Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
