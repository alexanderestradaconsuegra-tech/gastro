              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"restaurant_id\": \"{{ $json.restaurant_id }}\",\n  \"session_id\": {{ $json.session_id ? '\"' + $json.session_id + '\"' : 'null' }},\n  \"table_id\": {{ $json.table_id !== null ? $json.table_id : 'null' }},\n  \"waiter_id\": {{ $json.waiter_id ? '\"' + $json.waiter_id + '\"' : 'null' }},\n  \"rating\": {{ $json.rating }},\n  \"comment\": {{ $json.comment ? '\"' + $json.comment.replace(/\"/g, '\\\\\"') + '\"' : 'null' }},\n  \"source\": \"{{ $json.source }}\"\n}",
        "options": {}
      },
